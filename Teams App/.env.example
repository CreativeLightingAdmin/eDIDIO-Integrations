# eDIDIO Teams app config. Copy to `.env`. NEVER commit .env.
PORT=3978
# Base64 security token shown when you create the Teams Outgoing Webhook.
TEAMS_SECRET=
# The display name you gave the outgoing webhook (used to strip the @mention).
TEAMS_BOT_NAME=eDIDIO
# The eDIDIO REST API Gateway this app forwards to.
EDIDIO_GATEWAY_URL=http://192.168.1.100:8080
EDIDIO_API_KEY=
EDIDIO_CONTROLLER=192.168.1.50
