# eDIDIO Twitch bot configuration. Copy to `.env` and fill in. NEVER commit .env.

# --- Twitch ---
# The bot account's username (can be your own account).
TWITCH_USERNAME=mybotname
# OAuth token for that account, including the 'oauth:' prefix.
# Generate at https://twitchapps.com/tmi/  (or via the Twitch CLI).
TWITCH_OAUTH=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The channel to join (usually your channel).
TWITCH_CHANNEL=mychannel

# --- eDIDIO controller ---
EDIDIO_HOST=192.168.1.50
EDIDIO_PORT=23
EDIDIO_USE_TLS=false

# Announce command results back into chat (true/false).
ANNOUNCE=true
