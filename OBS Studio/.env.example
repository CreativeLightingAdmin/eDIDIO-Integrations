# eDIDIO OBS integration configuration. Copy to `.env` and fill in.

# --- OBS WebSocket ---
# In OBS: Tools -> WebSocket Server Settings. Enable the server, note the port
# and password.
OBS_URL=ws://127.0.0.1:4455
OBS_PASSWORD=

# --- eDIDIO controller ---
EDIDIO_HOST=192.168.1.50
EDIDIO_PORT=23
EDIDIO_USE_TLS=false
