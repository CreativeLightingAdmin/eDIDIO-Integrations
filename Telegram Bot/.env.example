# eDIDIO Telegram bot config. Copy to `.env` and fill in. NEVER commit .env.

# Bot token from @BotFather.
TELEGRAM_TOKEN=123456:ABC-DEF...

# eDIDIO controller.
EDIDIO_HOST=192.168.1.50
EDIDIO_PORT=23
EDIDIO_USE_TLS=false

# Optional allowlist of Telegram chat IDs (comma-separated) that may control the
# lighting. Leave blank to allow anyone (only sensible for a private bot).
# Send a message to the bot and check its logs, or use @userinfobot, to find IDs.
ALLOWED_CHAT_IDS=
