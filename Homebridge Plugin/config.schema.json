{
  "pluginAlias": "EdidioPlatform",
  "pluginType": "platform",
  "singular": false,
  "headerDisplay": "Control Freak eDIDIO lighting. Add DALI lights (a short address or a group) and stored scenes.",
  "schema": {
    "type": "object",
    "properties": {
      "name": { "title": "Name", "type": "string", "default": "eDIDIO", "required": true },
      "host": { "title": "Controller IP", "type": "string", "format": "ipv4", "required": true },
      "port": { "title": "Port", "type": "integer", "default": 23, "description": "23 = plain TCP, 443 = TLS" },
      "useTLS": { "title": "Use TLS", "type": "boolean", "default": false },
      "liveFeedback": {
        "title": "Live state from the controller",
        "type": "boolean",
        "default": true,
        "description": "Keeps Apple Home in sync with wall panels, schedules and other apps (firmware 1.4.0+)."
      },
      "lights": {
        "title": "Lights",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": { "title": "Name", "type": "string", "required": true },
            "line": { "title": "DALI line", "type": "integer", "minimum": 1, "maximum": 4, "default": 1 },
            "address": { "title": "Short address (0-63)", "type": "integer", "minimum": 0, "maximum": 63 },
            "group": { "title": "…or group (0-15)", "type": "integer", "minimum": 0, "maximum": 15 }
          }
        }
      },
      "scenes": {
        "title": "Scenes",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": { "title": "Name", "type": "string", "required": true },
            "line": { "title": "DALI line", "type": "integer", "minimum": 1, "maximum": 4, "default": 1 },
            "scene": { "title": "Scene (0-15)", "type": "integer", "minimum": 0, "maximum": 15, "required": true },
            "group": { "title": "Group (blank = broadcast)", "type": "integer", "minimum": 0, "maximum": 15 }
          }
        }
      }
    }
  }
}
