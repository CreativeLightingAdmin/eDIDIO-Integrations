# eDIDIO REST API Gateway configuration.
# Copy this file to `.env` and adjust. NEVER commit a real .env.

# HTTP server
PORT=8080
HOST=0.0.0.0

# Optional API key. If set, every /api request must send it as either the
# `X-API-Key` header or `Authorization: Bearer <key>`. Leave blank to disable
# auth (only appropriate on a trusted, isolated network).
EDIDIO_API_KEY=

# Default controller. Requests may omit the controller IP and this one is used.
# Leave blank to require an explicit `controller` in every control request.
EDIDIO_IP=
EDIDIO_PORT=23
EDIDIO_TLS_PORT=443
# Use TLS (port 443) by default instead of plain TCP (port 23).
EDIDIO_USE_TLS=false

# Keep-alive heartbeat interval (ms) sent to each controller socket.
HEARTBEAT_MS=7000
