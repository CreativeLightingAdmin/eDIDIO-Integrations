# eDIDIO REST API Gateway configuration.
# Copy this file to `.env` and adjust. NEVER commit a real .env.

# HTTP server
PORT=8080
HOST=0.0.0.0

# API keys. Every /api request must send one as the `X-API-Key` header or
# `Authorization: Bearer <key>` (GET requests may also use ?api_key=).
#   EDIDIO_API_KEY       full control
#   EDIDIO_READ_API_KEY  read-only (GET: status, /state, /events)
# With no key the gateway refuses to start unless HOST is loopback or
# EDIDIO_ALLOW_UNAUTHENTICATED=true (trusted, isolated networks only).
EDIDIO_API_KEY=
EDIDIO_READ_API_KEY=
EDIDIO_ALLOW_UNAUTHENTICATED=false

# Live events (firmware >= 1.4.0): powers /controllers/:ip/state and /events.
EDIDIO_EVENTS=true
EDIDIO_EVENT_CATEGORIES=dali,inputs,sensors,triggers

# Default controller. Requests may omit the controller IP and this one is used.
# Leave blank to require an explicit `controller` in every control request.
EDIDIO_IP=
EDIDIO_PORT=23
EDIDIO_TLS_PORT=443
# Use TLS (port 443) by default instead of plain TCP (port 23).
EDIDIO_USE_TLS=false

# Keep-alive heartbeat interval (ms) sent to each controller socket.
HEARTBEAT_MS=7000
